{
  "name": "ElectricalAsset",
  "type": "object",
  "properties": {
    "audit_id": {
      "type": "string",
      "title": "Audit ID"
    },
    "zone_id": {
      "type": "string",
      "title": "Zone ID (Spatial Parent)"
    },
    "asset_name": {
      "type": "string",
      "title": "Equipment Name"
    },
    "display_code": {
      "type": "string",
      "title": "Display Code"
    },
    "asset_type": {
      "type": "string",
      "title": "Asset Type",
      "enum": [
        "MSB",
        "MSSB",
        "DB",
        "HVAC-DB",
        "LX-DB",
        "PV-DB",
        "MCC",
        "Other"
      ]
    },
    "electrical_parent_id": {
      "type": "string",
      "title": "Electrical Parent Asset ID"
    },
    "electrical_parent_tbc": {
      "type": "boolean",
      "title": "Electrical Parent TBC",
      "default": false
    },
    "location_description": {
      "type": "string",
      "title": "Physical Location Description"
    },
    "phase": {
      "type": "string",
      "title": "Phase",
      "enum": [
        "Single Phase",
        "Three Phase",
        "Unknown"
      ]
    },
    "amperage_rating": {
      "type": "string",
      "title": "Amperage Rating (A)"
    },
    "site_nmi": {
      "type": "string",
      "title": "Site NMI"
    },
    "photo": {
      "type": "string",
      "title": "Photo"
    },
    "extra_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Additional Photos"
    },
    "meter_present": {
      "type": "boolean",
      "title": "Metering / Device Present",
      "default": false
    },
    "meters": {
      "type": "array",
      "title": "Meters / Devices",
      "items": {
        "type": "object",
        "properties": {
          "device_name": {
            "type": "string"
          },
          "device_number": {
            "type": "string"
          },
          "meter_device_type": {
            "type": "string"
          },
          "meter_device_id": {
            "type": "string"
          },
          "meter_classification": {
            "type": "string"
          },
          "meter_coverage_type": {
            "type": "string"
          },
          "ww_prestart": {
            "type": "object"
          },
          "ww_switchboard": {
            "type": "object"
          },
          "ww_channels": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "ww_verification": {
            "type": "object"
          },
          "ww_commissioning": {
            "type": "object"
          },
          "ww_photos": {
            "type": "object"
          }
        }
      }
    },
    "sub_circuits_description": {
      "type": "string",
      "title": "Sub-Circuits Description"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "audit_id",
    "zone_id",
    "asset_name",
    "asset_type"
  ]
}