{
  "name": "ElectricalAsset",
  "type": "object",
  "properties": {
    "audit_id": {
      "type": "string",
      "title": "Audit ID"
    },
    "zone_id": {
      "type": "string",
      "title": "Zone ID (Spatial Parent)"
    },
    "asset_name": {
      "type": "string",
      "title": "Equipment Name"
    },
    "display_code": {
      "type": "string",
      "title": "Display Code (e.g. SITE-LEVEL-EQUIPNAME-PARENT)"
    },
    "asset_type": {
      "type": "string",
      "title": "Asset Type",
      "enum": [
        "MSB",
        "MSSB",
        "DB",
        "HVAC-DB",
        "LX-DB",
        "PV-DB",
        "MCC",
        "Other"
      ]
    },
    "electrical_parent_id": {
      "type": "string",
      "title": "Electrical Parent Asset ID"
    },
    "electrical_parent_tbc": {
      "type": "boolean",
      "title": "Electrical Parent TBC",
      "default": false
    },
    "location_description": {
      "type": "string",
      "title": "Physical Location Description"
    },
    "phase": {
      "type": "string",
      "title": "Phase",
      "enum": [
        "Single Phase",
        "Three Phase",
        "Unknown"
      ]
    },
    "amperage_rating": {
      "type": "string",
      "title": "Amperage Rating (A)"
    },
    "site_nmi": {
      "type": "string",
      "title": "Site NMI"
    },
    "photo": {
      "type": "string",
      "title": "Photo"
    },
    "extra_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Additional Photos"
    },
    "meter_present": {
      "type": "boolean",
      "title": "Metering / Device Present",
      "default": false
    },
    "meter_device_type": {
      "type": "string",
      "title": "Device Type",
      "enum": [
        "A3RM Auditor",
        "A6M Auditor",
        "Other Meter"
      ]
    },
    "meter_device_id": {
      "type": "string",
      "title": "Meter Device ID / Serial"
    },
    "meter_classification": {
      "type": "string",
      "title": "Meter Classification",
      "enum": [
        "Utility / Gate Meter",
        "Sub-meter",
        "Check Meter",
        "Solar / Generation Meter",
        "Other"
      ]
    },
    "meter_coverage_type": {
      "type": "string",
      "title": "Meter Coverage Type",
      "enum": [
        "Entire Board Load",
        "Specific Outgoing Circuit",
        "Multiple Circuits",
        "Unknown"
      ]
    },
    "sub_circuits_description": {
      "type": "string",
      "title": "Sub-Circuits Description"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    },
    "ww_prestart": {
      "type": "object",
      "title": "Pre-start Information"
    },
    "ww_switchboard": {
      "type": "object",
      "title": "Switchboard & Device Details"
    },
    "ww_channels": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Channel Configuration"
    },
    "ww_verification": {
      "type": "object",
      "title": "App Verification & Measurements"
    },
    "ww_commissioning": {
      "type": "object",
      "title": "Commissioning"
    },
    "ww_photos": {
      "type": "object",
      "title": "Installation Photos"
    }
  },
  "required": [
    "audit_id",
    "zone_id",
    "asset_name",
    "asset_type"
  ]
}